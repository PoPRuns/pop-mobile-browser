+package org.recompile.mobile;
+
+import java.security.MessageDigest;
+import org.objectweb.asm.ClassReader;
+
+/** Issue #20: allocate the missing one-byte level-read buffer. */
+final class LevelLoadingCompat {
+    private static final String CLASS_SHA256 =
+        "3132440d7fa147f48647468b39f0691beeb72bc6e0777a0d4b6bb1ca387a15da";
+
+    static ClassReader remap(ClassReader reader) throws Exception {
+        if (!"Z".equals(reader.getClassName())) return reader;
+        StringBuilder hex = new StringBuilder();
+        for (byte b : MessageDigest.getInstance("SHA-256").digest(reader.b)) {
+            int n = b & 255;
+            if (n < 16) hex.append('0');
+            hex.append(Integer.toHexString(n));
+        }
+        if (!CLASS_SHA256.equals(hex.toString())) return reader;
+
+        // Exact fingerprint and unique instruction sequence: replace GETSTATIC
+        // yI with ICONST_1 NEWARRAY T_BYTE, matching diagnostic B exactly.
+        // Both sequences occupy three bytes and push one byte[] reference.
+        // Preserve branch targets, stack maps and all other class bytes.
+        int[] pattern = {0xb2,0x00,0x16,0xb2,0x01,0x6d,0x03,0x06,
+                         0xb8,0x01,0x68,0xb6,0x01,0x69};
+        byte[] bytes = reader.b.clone();
+        int found = -1;
+        for (int i = 0; i <= bytes.length - pattern.length; i++) {
+            boolean match = true;
+            for (int j = 0; j < pattern.length; j++) {
+                if ((bytes[i+j] & 255) != pattern[j]) { match = false; break; }
+            }
+            if (match) {
+                if (found != -1) throw new IllegalStateException("Duplicate WW level buffer sequence");
+                found = i;
+            }
+        }
+        if (found == -1) throw new IllegalStateException("Missing WW level buffer sequence");
+        bytes[found+3] = 0x04;
+        bytes[found+4] = (byte) 0xbc;
+        bytes[found+5] = 0x08;
+        ClassReader result = new ClassReader(bytes);
+        System.out.println("[POP-COMPAT] Applied Warrior Within issue #20 level-loading buffer fix");
+        return result;
+    }
+}
