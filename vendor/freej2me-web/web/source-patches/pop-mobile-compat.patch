@@ -0,0 +1,100 @@
+package org.recompile.mobile;
+
+import java.security.MessageDigest;
+import org.objectweb.asm.ClassReader;
+
+/** Issue #7: restore input callbacks in the verified CanvasPlus-based game. */
+final class CanvasInputCompat {
+    private static final String CLASS_SHA256 =
+        "ca4699d9278f15c59cfcbdaf47fc0e00f43c171b9e3e55527fe12dd36b37ddd6";
+
+    static ClassReader remap(ClassReader reader) throws Exception {
+        if (!"pop2/e".equals(reader.getClassName())) return reader;
+        byte[] original = reader.b;
+        StringBuilder hex = new StringBuilder();
+        for (byte b : MessageDigest.getInstance("SHA-256").digest(original)) {
+            int n = b & 255;
+            if (n < 16) hex.append('0');
+            hex.append(Integer.toHexString(n));
+        }
+        if (!CLASS_SHA256.equals(hex.toString())) return reader;
+
+        // Reproduce diagnostic variant B without changing instruction offsets.
+        byte[] data = original.clone();
+        int count = u2(data, 8), p = 10, namesChanged = 0, ownersChanged = 0;
+        String[] names = new String[count];
+        for (int i = 1; i < count; i++) {
+            int start = p;
+            int tag = data[p++] & 255;
+            switch (tag) {
+            case 1:
+                int length = u2(data, p);
+                p += 2;
+                String name = new String(data, p, length, "ISO-8859-1");
+                names[i] = name;
+                String mapped = null;
+                if ("keyPressee".equals(name)) mapped = "keyPressed";
+                if ("keyReleasee".equals(name)) mapped = "keyReleased";
+                if (mapped != null) {
+                    byte[] bytes = mapped.getBytes("ISO-8859-1");
+                    if (bytes.length != length) throw new IllegalStateException("Callback length changed");
+                    System.arraycopy(bytes, 0, data, p, length);
+                    namesChanged++;
+                }
+                p += length; break;
+            case 3: case 4: case 9: case 10: case 11: case 12:
+                p += 4; break;
+            case 5: case 6:
+                p += 8; i++; break;
+            case 7: case 8:
+                p += 2; break;
+            default:
+                throw new IllegalStateException("Unexpected CanvasPlus constant-pool tag: " + tag);
+            }
+            if (i == 53 || i == 54) {
+                if (tag != 10 || u2(data, start + 1) != 350)
+                    throw new IllegalStateException("Unexpected inherited repaint owner");
+                put2(data, start + 1, 274);
+                ownersChanged++;
+            }
+        }
+        if (namesChanged != 2 || ownersChanged != 2)
+            throw new IllegalStateException("Unexpected CanvasPlus remap counts");
+        p += 6; // access_flags, this_class, super_class
+        p += 2 + 2 * u2(data, p); // interfaces
+        int fields = u2(data, p); p += 2;
+        for (int i = 0; i < fields; i++) p = skipMember(data, p);
+        int methods = u2(data, p); p += 2;
+        int fixed = 0;
+        for (int i = 0; i < methods; i++) {
+            String name = names[u2(data, p + 2)];
+            String desc = names[u2(data, p + 4)];
+            if (("keyPressee".equals(name) || "keyReleasee".equals(name)) && "(I)V".equals(desc)) {
+                int flags = u2(data, p);
+                if ((flags & 7) != 4) throw new IllegalStateException("Unexpected callback visibility");
+                put2(data, p, (flags & ~7) | 1);
+                fixed++;
+            }
+            p = skipMember(data, p);
+        }
+        if (fixed != 2) throw new IllegalStateException("Missing input callbacks");
+        ClassReader mapped = new ClassReader(data);
+        System.out.println("[POP-COMPAT] Applied Sands of Time issue #7 input callback fix");
+        return mapped;
+    }
+
+    private static int u2(byte[] b, int p) {
+        return ((b[p] & 255) << 8) | (b[p + 1] & 255);
+    }
+    private static int u4(byte[] b, int p) {
+        return (u2(b, p) << 16) | u2(b, p + 2);
+    }
+    private static void put2(byte[] b, int p, int n) {
+        b[p] = (byte)(n >>> 8); b[p + 1] = (byte)n;
+    }
+    private static int skipMember(byte[] b, int p) {
+        int attrs = u2(b, p + 6); p += 8;
+        for (int i = 0; i < attrs; i++) p += 6 + u4(b, p + 2);
+        return p;
+    }
+}
diff --git a/src/org/recompile/mobile/CjspSoundCompat.java b/src/org/recompile/mobile/CjspSoundCompat.java
