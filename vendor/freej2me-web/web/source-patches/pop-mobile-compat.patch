+package org.recompile.mobile;
+
+import java.security.MessageDigest;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.ClassVisitor;
+import org.objectweb.asm.ClassAdapter;
+import org.objectweb.asm.MethodVisitor;
+import org.objectweb.asm.MethodAdapter;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.Label;
+
+/** Runtime compatibility fixes for verified legacy busy-wait loops. */
+final class BusyWaitCompat implements Opcodes {
+    private static final String CLASS_SHA256 =
+        "897456016f5b0e5e6b94619f4b9132a9c441fe027f71e558a3df277b83bb5eb3";
+
+    private static final String SOT_AUDIO_SHA256 =
+        "72d1f8021547cb6344f72638ed4189ec53e4d2b2928b34af5a7653169d763fd8";
+
+    private static final String SOT_31_AUDIO_SHA256 =
+        "6a9de27f14f095167c732b929c8787925c14a8af43a8876552ac7cfb6d4a2cd8";
+
+    private static final String SOT_9_AUDIO_SHA256 =
+        "d0d7fac06b626530a5507fedf702824e47c1eed47a631d271d6aec60c278f9fd";
+
+    private static final String WW_15_AUDIO_SHA256 =
+        "f4090b89e0b2b56f8b4221be27333a2666d9b879aac02de046964c1e413786f5";
+    private static final String WW_15_AUDIO_PAUSE = "popIssue15Pause";
+
+    private static final String WW_18_AUDIO_SHA256 =
+        "33cf81e68ff5e72ec27d7c7e562b18e41195d4a40a32cd18bc3e0b6a8c01daad";
+    private static final String WW_18_AUDIO_PAUSE = "popIssue18Pause";
+
+    private static final String WW_35_AUDIO_SHA256 =
+        "4401a582e3e9084f0ce67f28301b8b3b7b16e7df1d4a3c933503ea8ec97d10a3";
+    private static final String WW_35_AUDIO_PAUSE = "popIssue35Pause";
+
+    private static final String HA_AUDIO_SHA256 =
+        "a3fe692bcc7c311647ab48f60f6fa22dc59ec57e4cddd6e8e7e9a4997a28b925";
+    private static final String HA_AUDIO_PAUSE = "popIssue13Pause";
+    private static final String HA_STARTUP_SHA256 =
+        "d25f3aab077ae78d16edf0fe1a3e05895503337782e55cee59b8448a92083bb1";
+    private static final String HA_STARTUP_PAUSED = "popIssue13Paused";
+
+    private static boolean matches(ClassReader reader, String className,
+            String fingerprint) throws Exception {
+        if (!className.equals(reader.getClassName())) return false;
+        byte[] hash = MessageDigest.getInstance("SHA-256").digest(reader.b);
+        StringBuilder hex = new StringBuilder();
+        for (byte b : hash) {
+            int n = b & 255;
+            if (n < 16) hex.append('0');
+            hex.append(Integer.toHexString(n));
+        }
+        return fingerprint.equals(hex.toString());
+    }
+
+    private static final String WW_25_STARTUP_SHA256 =
+        "a83e5156394619f55656475650334a0f43de63fbdeefe751fed2feaf82f2116e";
+    private static final String WW_25_STARTUP_PAUSE = "popIssue25Pause";
+
+    // Diagnostic B: only f.N() and f.h(), not f.run() or a.run().
+    private static ClassVisitor wrapIssue25(ClassVisitor downstream) {
+        return new ClassAdapter(downstream) {
+            private int startupYields, introYields;
+
+            public MethodVisitor visitMethod(int access, final String name, String desc,
+                    String signature, String[] exceptions) {
+                MethodVisitor target = super.visitMethod(access, name, desc, signature, exceptions);
+                if (!"()V".equals(desc) || !("N".equals(name) || "h".equals(name))) return target;
+                return new MethodAdapter(target) {
+                    public void visitMethodInsn(int opcode, String owner, String method, String desc) {
+                        if (opcode == INVOKESTATIC && "java/lang/Thread".equals(owner)
+                                && "yield".equals(method) && "()V".equals(desc)) {
+                            if ("N".equals(name)) startupYields++; else introYields++;
+                            super.visitMethodInsn(INVOKESTATIC, "f", WW_25_STARTUP_PAUSE, "()V");
+                            return;
+                        }
+                        super.visitMethodInsn(opcode, owner, method, desc);
+                    }
+                };
+            }
+
+            public void visitEnd() {
+                if (startupYields != 2 || introYields != 4) {
+                    throw new IllegalStateException("Expected WW #25 startup wait sites not found");
+                }
+                MethodVisitor method = super.visitMethod(ACC_PRIVATE | ACC_STATIC | ACC_SYNTHETIC,
+                        WW_25_STARTUP_PAUSE, "()V", null, null);
+                Label start = new Label(), end = new Label(), handler = new Label();
+                method.visitCode();
+                method.visitTryCatchBlock(start, end, handler, "java/lang/InterruptedException");
+                method.visitLabel(start);
+                method.visitInsn(LCONST_1);
+                method.visitMethodInsn(INVOKESTATIC, "java/lang/Thread", "sleep", "(J)V");
+                method.visitLabel(end);
+                method.visitInsn(RETURN);
+                method.visitLabel(handler);
+                method.visitInsn(POP);
+                method.visitInsn(RETURN);
+                method.visitMaxs(2, 0);
+                method.visitEnd();
+                System.out.println("[POP-COMPAT] Applied Warrior Within issue #25 startup busy-wait fix");
+                super.visitEnd();
+            }
+        };
+    }
+
+    static ClassVisitor wrap(ClassVisitor downstream, ClassReader reader) throws Exception {
+        if (matches(reader, "f", WW_25_STARTUP_SHA256)) return wrapIssue25(downstream);
+        final boolean chapter1 = matches(reader, "prince/l", CLASS_SHA256);
+        final boolean sotAudio = matches(reader, "F", SOT_AUDIO_SHA256);
+        final boolean sot31Audio = matches(reader, "F", SOT_31_AUDIO_SHA256);
+        final boolean sot9Audio = matches(reader, "b", SOT_9_AUDIO_SHA256);
+        final boolean ww15Audio = matches(reader, "a", WW_15_AUDIO_SHA256);
+        final boolean ww18Audio = matches(reader, "d", WW_18_AUDIO_SHA256);
+        final boolean ww35Audio = matches(reader, "e", WW_35_AUDIO_SHA256);
+        final boolean haAudio = matches(reader, "L", HA_AUDIO_SHA256);
+        final boolean haStartup = matches(reader, "F", HA_STARTUP_SHA256);
+        if (!chapter1 && !sotAudio && !sot31Audio && !sot9Audio && !ww15Audio && !ww18Audio && !ww35Audio && !haAudio && !haStartup) return downstream;
+        return new ClassAdapter(downstream) {
+            private boolean ww15AudioPatched;
+            private boolean ww18AudioPatched;
+            private boolean ww35AudioPatched;
+            private boolean haAudioPatched;
+            private boolean haStartupPatched;
+
+            public void visitEnd() {
+                if (haAudioPatched || haStartupPatched) {
+                    // Equivalent to the diagnostic B helper, but defined in L
+                    // itself: no extra game class or emulator dependency.
+                    MethodVisitor method = super.visitMethod(
+                            ACC_PRIVATE | ACC_STATIC | ACC_SYNTHETIC,
+                            HA_AUDIO_PAUSE, "()V", null, null);
+                    Label start = new Label(), end = new Label(), handler = new Label();
+                    method.visitCode();
+                    method.visitTryCatchBlock(start, end, handler, "java/lang/InterruptedException");
+                    method.visitLabel(start);
+                    method.visitInsn(LCONST_1);
+                    method.visitMethodInsn(INVOKESTATIC, "java/lang/Thread", "sleep", "(J)V");
+                    method.visitLabel(end);
+                    method.visitInsn(RETURN);
+                    method.visitLabel(handler);
+                    method.visitInsn(POP);
+                    method.visitInsn(RETURN);
+                    method.visitMaxs(2, 0);
+                    method.visitEnd();
+                }
+                if (haStartupPatched) {
+                    // Sample the original paused flag once; sleep only when
+                    // true, then return that same value (diagnostic E).
+                    MethodVisitor method = super.visitMethod(
+                            ACC_PRIVATE | ACC_STATIC | ACC_SYNTHETIC,
+                            HA_STARTUP_PAUSED, "()Z", null, null);
+                    Label done = new Label();
+                    method.visitCode();
+                    method.visitFieldInsn(GETSTATIC, "F", "addRecord", "Z");
+                    method.visitInsn(DUP);
+                    method.visitJumpInsn(IFEQ, done);
+                    method.visitMethodInsn(INVOKESTATIC, "F", HA_AUDIO_PAUSE, "()V");
+                    method.visitLabel(done);
+                    method.visitInsn(IRETURN);
+                    method.visitMaxs(2, 0);
+                    method.visitEnd();
+                }
+                if (ww15AudioPatched) {
+                    // Same stack-neutral, interruption-safe pause as diagnostic B.
+                    // The original a.run() has max_stack=1 and no catch block.
+                    MethodVisitor method = super.visitMethod(
+                            ACC_PRIVATE | ACC_STATIC | ACC_SYNTHETIC,
+                            WW_15_AUDIO_PAUSE, "()V", null, null);
+                    Label start = new Label(), end = new Label(), handler = new Label();
+                    method.visitCode();
+                    method.visitTryCatchBlock(start, end, handler, "java/lang/InterruptedException");
+                    method.visitLabel(start);
+                    method.visitInsn(LCONST_1);
+                    method.visitMethodInsn(INVOKESTATIC, "java/lang/Thread", "sleep", "(J)V");
+                    method.visitLabel(end);
+                    method.visitInsn(RETURN);
+                    method.visitLabel(handler);
+                    method.visitInsn(POP);
+                    method.visitInsn(RETURN);
+                    method.visitMaxs(2, 0);
+                    method.visitEnd();
+                }
+                if (ww18AudioPatched || ww35AudioPatched) {
+                    // Stack-neutral pause, equivalent to diagnostic B.
+                    MethodVisitor method = super.visitMethod(
+                            ACC_PRIVATE | ACC_STATIC | ACC_SYNTHETIC,
+                            ww35AudioPatched ? WW_35_AUDIO_PAUSE : WW_18_AUDIO_PAUSE, "()V", null, null);
+                    Label start = new Label(), end = new Label(), handler = new Label();
+                    method.visitCode();
+                    method.visitTryCatchBlock(start, end, handler, "java/lang/InterruptedException");
+                    method.visitLabel(start);
+                    method.visitInsn(LCONST_1);
+                    method.visitMethodInsn(INVOKESTATIC, "java/lang/Thread", "sleep", "(J)V");
+                    method.visitLabel(end);
+                    method.visitInsn(RETURN);
+                    method.visitLabel(handler);
+                    method.visitInsn(POP);
+                    method.visitInsn(RETURN);
+                    method.visitMaxs(2, 0);
+                    method.visitEnd();
+                }
+                if (ww18Audio && !ww18AudioPatched) {
+                    throw new IllegalStateException("Expected WW #18 loop header not found");
+                }
+                if (ww35Audio && !ww35AudioPatched) {
+                    throw new IllegalStateException("Expected WW #35 loop back edge not found");
+                }
+                super.visitEnd();
+            }
+
+            public MethodVisitor visitMethod(int access, String name, String desc,
+                    String signature, String[] exceptions) {
+                MethodVisitor target = super.visitMethod(access, name, desc, signature, exceptions);
+                if (!"run".equals(name) || !"()V".equals(desc)) return target;
+                return new MethodAdapter(target) {
+                    private int clockReads;
+                    private int haAudioYields;
+                    private int ww35Gotos;
+                    public void visitJumpInsn(int opcode, Label label) {
+                        // Fingerprinted e.run(): the second GOTO is at offset 28,
+                        // the target of the initial jump and both conditionals.
+                        // Insert after its label and before GOTO 5, so every
+                        // path through the polling loop executes the pause.
+                        if (ww35Audio && opcode == GOTO && ++ww35Gotos == 2) {
+                            super.visitMethodInsn(INVOKESTATIC, "e", WW_35_AUDIO_PAUSE, "()V");
+                            ww35AudioPatched = true;
+                            System.out.println("[POP-COMPAT] Applied Warrior Within issue #35 audio busy-wait fix");
+                        }
+                        super.visitJumpInsn(opcode, label);
+                    }
+                    public void visitVarInsn(int opcode, int var) {
+                        // Exact d.run() fingerprint: its sole ALOAD 0 is at
+                        // offset 12, after the loop-target label. Both backward
+                        // branches therefore execute the pause on each iteration.
+                        if (ww18Audio && opcode == ALOAD && var == 0) {
+                            if (ww18AudioPatched) throw new IllegalStateException("Unexpected second WW #18 ALOAD 0");
+                            super.visitMethodInsn(INVOKESTATIC, "d", WW_18_AUDIO_PAUSE, "()V");
+                            ww18AudioPatched = true;
+                            System.out.println("[POP-COMPAT] Applied Warrior Within issue #18 audio busy-wait fix");
+                        }
+                        super.visitVarInsn(opcode, var);
+                    }
+                    public void visitFieldInsn(int opcode, String owner, String name, String desc) {
+                        // Only the paused-flag read in the fingerprinted F.run(),
+                        // original offset 14. Do not alter the 83 ms frame loop.
+                        if (haStartup && opcode == GETSTATIC && "F".equals(owner)
+                                && "addRecord".equals(name) && "Z".equals(desc)) {
+                            if (haStartupPatched) throw new IllegalStateException("Unexpected second pause read");
+                            super.visitMethodInsn(INVOKESTATIC, "F", HA_STARTUP_PAUSED, "()Z");
+                            haStartupPatched = true;
+                            System.out.println("[POP-COMPAT] Applied Harem Adventures issue #13 startup busy-wait fix");
+                            return;
+                        }
+                        super.visitFieldInsn(opcode, owner, name, desc);
+                    }
+                    public void visitMethodInsn(int opcode, String owner, String name, String desc) {
+                        // Issue #13: keep the yield under the queue monitor.
+                        // Replace only the second yield (original offset 102),
+                        // after monitorexit, as in the successful B experiment.
+                        if (haAudio && opcode == INVOKESTATIC
+                                && "java/lang/Thread".equals(owner)
+                                && "yield".equals(name) && "()V".equals(desc)
+                                && ++haAudioYields == 2) {
+                            super.visitMethodInsn(INVOKESTATIC, "L", HA_AUDIO_PAUSE, "()V");
+                            haAudioPatched = true;
+                            System.out.println("[POP-COMPAT] Applied Harem Adventures issue #13 audio busy-wait fix");
+                            return;
+                        }
+                        // Issue #15: the sole yield in the verified a.run(), offset 21.
+                        if (ww15Audio && opcode == INVOKESTATIC
+                                && "java/lang/Thread".equals(owner)
+                                && "yield".equals(name) && "()V".equals(desc)) {
+                            if (ww15AudioPatched) throw new IllegalStateException("Unexpected second WW audio yield");
+                            super.visitMethodInsn(INVOKESTATIC, "a", WW_15_AUDIO_PAUSE, "()V");
+                            ww15AudioPatched = true;
+                            System.out.println("[POP-COMPAT] Applied Warrior Within issue #15 audio busy-wait fix");
+                            return;
+                        }
+                        // Issues #5, #31 and #9: each verified audio run() has one idle yield.
+                        // Issue #9 uses b.run(), with original max_stack 6.
+                        // Its existing catch (Exception) covers this call and
+                        // resumes the loop on InterruptedException. The original
+                        // max_stack is 3, enough for the two-slot long argument.
+                        if ((sotAudio || sot31Audio || sot9Audio) && opcode == INVOKESTATIC
+                                && "java/lang/Thread".equals(owner)
+                                && "yield".equals(name) && "()V".equals(desc)) {
+                            super.visitInsn(LCONST_1);
+                            super.visitMethodInsn(INVOKESTATIC, "java/lang/Thread", "sleep", "(J)V");
+                            System.out.println(sot9Audio
+                                    ? "[POP-COMPAT] Applied Sands of Time issue #9 audio busy-wait fix"
+                                    : sot31Audio
+                                    ? "[POP-COMPAT] Applied Sands of Time issue #31 audio busy-wait fix"
+                                    : "[POP-COMPAT] Applied Sands of Time audio busy-wait fix");
+                            return;
+                        }
+                        if (chapter1 && opcode == INVOKESTATIC && "java/lang/System".equals(owner)
+                                && "currentTimeMillis".equals(name) && "()J".equals(desc)
+                                && ++clockReads == 2) {
+                            // Sleep before the repeated clock read, not the frame's initial read.
+                            // The original 110 ms deadline is unchanged.
+                            mv.visitInsn(LCONST_1);
+                            mv.visitMethodInsn(INVOKESTATIC, "java/lang/Thread", "sleep", "(J)V");
+                            System.out.println("[POP-COMPAT] Applied Chapter 1 busy-wait fix");
+                        }
+                        super.visitMethodInsn(opcode, owner, name, desc);
+                    }
+                };
+            }
+        };
+    }
+}
diff --git a/src/org/recompile/mobile/CanvasInputCompat.java b/src/org/recompile/mobile/CanvasInputCompat.java
