+++ b/src/org/recompile/mobile/CjspSoundCompat.java
@@ -0,0 +1,72 @@
+package org.recompile.mobile;
+
+import java.io.ByteArrayOutputStream;
+import java.security.MessageDigest;
+import org.objectweb.asm.ClassReader;
+
+/** Issue #6: map the verified Sharp GX10 CJSP sound references to Vodafone. */
+final class CjspSoundCompat {
+    private static final String CLASS_SHA256 =
+        "d493abdb9c09aad0b3d82f3727563b4013788467b2c930ca8494d7bc4196c2a6";
+    private static final String OLD = "com/gcjsp/v10/sound/";
+    private static final String NEW = "com/vodafone/v10/sound/";
+
+    static ClassReader remap(ClassReader reader) throws Exception {
+        if (!"pop2/e".equals(reader.getClassName())) return reader;
+        byte[] original = reader.b;
+        byte[] hash = MessageDigest.getInstance("SHA-256").digest(original);
+        StringBuilder hex = new StringBuilder();
+        for (byte b : hash) {
+            int n = b & 255;
+            if (n < 16) hex.append('0');
+            hex.append(Integer.toHexString(n));
+        }
+        if (!CLASS_SHA256.equals(hex.toString())) return reader;
+
+        // Same constant-pool rewrite as diagnostic B. ISO-8859-1 maps each
+        // byte to one character, so unrelated modified UTF-8 bytes survive.
+        ByteArrayOutputStream out = new ByteArrayOutputStream(original.length + 128);
+        out.write(original, 0, 10);
+        int count = u2(original, 8), p = 10, changed = 0;
+        for (int i = 1; i < count; i++) {
+            int start = p;
+            int tag = original[p++] & 255;
+            switch (tag) {
+            case 1:
+                int length = u2(original, p);
+                p += 2;
+                String raw = new String(original, p, length, "ISO-8859-1");
+                p += length;
+                String value = raw.replace(OLD, NEW);
+                if (!raw.equals(value)) {
+                    byte[] bytes = value.getBytes("ISO-8859-1");
+                    out.write(tag);
+                    out.write(bytes.length >>> 8);
+                    out.write(bytes.length & 255);
+                    out.write(bytes, 0, bytes.length);
+                    changed++;
+                    continue;
+                }
+                break;
+            case 3: case 4: case 9: case 10: case 11: case 12:
+                p += 4; break;
+            case 5: case 6:
+                p += 8; i++; break;
+            case 7: case 8:
+                p += 2; break;
+            default:
+                throw new IllegalStateException("Unexpected CJSP constant-pool tag: " + tag);
+            }
+            out.write(original, start, p - start);
+        }
+        if (changed != 9) throw new IllegalStateException("Unexpected CJSP remap count: " + changed);
+        out.write(original, p, original.length - p);
+        ClassReader mapped = new ClassReader(out.toByteArray());
+        System.out.println("[POP-COMPAT] Applied Sands of Time issue #6 CJSP sound API remap");
+        return mapped;
+    }
+
+    private static int u2(byte[] b, int p) {
+        return ((b[p] & 255) << 8) | (b[p + 1] & 255);
+    }
+}
